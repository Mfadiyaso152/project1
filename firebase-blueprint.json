{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with saved assets for Watheeq notarization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "authProvider": { "type": "string" },
        "avatar": { "type": "string" },
        "phone": { "type": "string" },
        "dob": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "theme": { "type": "string" },
        "savedAssets": {
          "type": "object",
          "properties": {
            "template": { "type": "string" },
            "stamp": { "type": "string" },
            "signature": { "type": "string" }
          }
        }
      },
      "required": ["email", "name"]
    },
    "UserAsset": {
      "title": "UserAsset",
      "description": "Stores individual persistent assets (official paper, stamp, signature) tied to a user account",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string", "enum": ["template", "stamp", "signature"] },
        "data": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "type", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles and cached references"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "UserAsset",
      "description": "Stores persistent user assets across all devices and browsers"
    }
  }
}
